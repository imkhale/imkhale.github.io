---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { NAME, SOCIALS } from "../../site.config.mjs";
---

<BaseLayout title="CV" description={`View or download ${NAME}'s CV.`}>
  <section class="section cv-section">
    <div class="container-narrow cv-header">
      <h1 data-reveal>CV</h1>
      <a href={SOCIALS.cvUrl} download class="btn btn-primary" data-reveal>
        Download PDF
        <Icon name="download" size={16} />
      </a>
    </div>

    <div class="cv-viewer" data-reveal>
      <iframe src={SOCIALS.cvUrl} title={`${NAME} CV`} loading="lazy"></iframe>
      <p class="text-muted cv-fallback">
        Not loading? <a href={SOCIALS.cvUrl} target="_blank" rel="noopener noreferrer">
          Open the PDF directly
        </a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .cv-section {
    padding-block: var(--space-16) var(--space-24);
  }

  .cv-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .cv-viewer {
    width: 100%;
    max-width: var(--content-width-narrow);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .cv-viewer iframe {
    width: 100%;
    height: 80vh;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .cv-fallback {
    margin-top: var(--space-3);
    font-size: var(--text-md);
    text-align: center;
  }

  @media (max-width: 640px) {
    .cv-viewer iframe {
      height: 65vh;
    }
  }
</style>
