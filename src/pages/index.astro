---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ImpactHighlights from "../components/ImpactHighlights.astro";
import About from "../components/About.astro";
import Skills from "../components/Skills.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Certifications from "../components/Certifications.astro";
import Education from "../components/Education.astro";
---

{/*
  Order is the argument the page makes: who I am (Hero, About) → what I can
  do (Skills) → where I've done it (Experience) → the receipts (Impact) →
  what I'm building now (Projects) → the paper trail (Certifications,
  Education).

  Featured impact deliberately sits AFTER Experience rather than before
  About: those numbers are evidence, and evidence only lands once the reader
  knows whose it is. Projects follows immediately because it's the strongest
  analytics-engineering signal on the page.
*/}
<BaseLayout>
  <Hero />
  <About />
  <Skills />
  <Experience />
  <ImpactHighlights />
  <Projects />
  <Certifications />
  <Education />
</BaseLayout>
