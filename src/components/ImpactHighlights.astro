---
import { FEATURED_IMPACT } from "../data/experience";
---

<section class="impact" aria-labelledby="impact-heading">
  <div class="container">
    <div class="impact-panel surface" data-reveal>
      <p class="eyebrow impact-eyebrow" id="impact-heading">Featured impact</p>
      <dl class="impact-grid">
        {
          FEATURED_IMPACT.map((item) => (
            <div class="impact-tile">
              <dt class="impact-value text-mono">{item.value}</dt>
              <dd class="impact-body">
                <span class="impact-label">{item.label}</span>
                <span class="text-muted impact-company">{item.company}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .impact {
    padding-block: var(--space-8) var(--space-24);
  }

  @media (max-width: 640px) {
    .impact {
      padding-block: var(--space-4) var(--space-16);
    }
  }

  /* A single bordered panel rather than three free-floating rules. The
     enclosure is what makes this read as an audited summary — the numbers
     look reported rather than decorative, which is the register a C-level
     reader trusts. */
  .impact-panel {
    padding: var(--space-10) var(--space-12);
  }

  .impact-eyebrow {
    margin-bottom: var(--space-8);
  }

  .impact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-10);
    margin: 0;
  }

  /* Hairline dividers between columns instead of a leading accent bar on
     each tile — separators sit behind the content rather than pointing at
     it, which keeps the numbers as the loudest thing in the panel. */
  .impact-tile + .impact-tile {
    padding-inline-start: var(--space-10);
    border-inline-start: 1px solid var(--color-border);
  }

  .impact-value {
    display: block;
    font-size: clamp(2.25rem, 3vw + 1rem, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .impact-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
  }

  .impact-label {
    font-size: var(--text-base);
    line-height: 1.5;
    max-width: 26ch;
  }

  .impact-company {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  @media (max-width: 900px) {
    .impact-panel {
      padding: var(--space-8);
    }

    .impact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8);
    }

    /* The 3rd tile wraps to a new row, so column dividers stop lining up.
       Reset them and divide by row instead. */
    .impact-tile + .impact-tile {
      padding-inline-start: 0;
      border-inline-start: none;
    }

    .impact-tile:nth-child(n + 3) {
      padding-top: var(--space-8);
      border-top: 1px solid var(--color-border);
    }
  }

  @media (max-width: 560px) {
    .impact-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .impact-tile + .impact-tile {
      padding-top: var(--space-6);
      border-top: 1px solid var(--color-border);
    }
  }
</style>
