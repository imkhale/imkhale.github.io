---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import ArchitectureDiagram from "./ArchitectureDiagram.astro";
import { PROJECTS } from "../data/projects";
import { SOCIALS } from "../../site.config.mjs";

// The first project is the feature; the rest fill a grid underneath. With one
// project this reads as a deliberate case study rather than a lonely tile,
// and it stays correct at any count without a layout rewrite.
const [featured, ...rest] = PROJECTS;

// The "More on GitHub" tile exists to stop a short grid looking unfinished.
// Once there are enough real entries to fill a row it's just noise.
const showGithubTile = rest.length < 2;
---

<section class="section section-alt" id="projects">
  <div class="container">
    <SectionHeading
      eyebrow="Building"
      title="Projects"
      note="Where the analytics engineering side gets built in the open — modeled, tested, and version-controlled rather than described."
    />

    {
      featured && (
        <article class="featured surface" data-reveal>
          <div class="featured-body">
            <div class="featured-head">
              <h3>{featured.title}</h3>
              <span
                class:list={[
                  "status",
                  featured.status === "In progress"
                    ? "status-wip"
                    : "status-done",
                ]}
              >
                {featured.status}
              </span>
            </div>

            <p class="text-muted featured-description">
              {featured.description}
            </p>

            {featured.highlights && (
              <ul class="featured-highlights">
                {featured.highlights.map((highlight) => (
                  <li>
                    <Icon name="check" size={15} class="highlight-tick" />
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            )}

            <ul class="stack">
              {featured.stack.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>

            <div class="links">
              {featured.githubUrl ? (
                <a
                  href={featured.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link"
                >
                  <Icon name="github" size={16} />
                  Source
                </a>
              ) : (
                <p class="text-muted pending">Case study coming soon</p>
              )}
              {featured.liveUrl && (
                <a
                  href={featured.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link"
                >
                  <Icon name="external-link" size={16} />
                  Live
                </a>
              )}
            </div>
          </div>

          {featured.diagram && (
            <div class="featured-diagram">
              <ArchitectureDiagram title={`${featured.title} architecture`} />
            </div>
          )}
        </article>
      )
    }

    {
      (rest.length > 0 || showGithubTile) && (
        <div class="grid">
          {rest.map((project) => (
            <article class="card surface surface-interactive" data-reveal>
              <div class="card-head">
                <h3>{project.title}</h3>
                <span
                  class:list={[
                    "status",
                    project.status === "In progress"
                      ? "status-wip"
                      : "status-done",
                  ]}
                >
                  {project.status}
                </span>
              </div>

              <p class="text-muted card-description">{project.description}</p>

              {project.pipeline && (
                <div class="pipeline" aria-hidden="true">
                  {project.pipeline.map((stage, i) => (
                    <>
                      <span class="pipeline-node">{stage}</span>
                      {i < project.pipeline!.length - 1 && (
                        <span class="pipeline-arrow">&rarr;</span>
                      )}
                    </>
                  ))}
                </div>
              )}

              <ul class="stack">
                {project.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>

              <div class="links">
                {project.githubUrl ? (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link"
                  >
                    <Icon name="github" size={16} />
                    Source
                  </a>
                ) : (
                  <p class="text-muted pending">Case study coming soon</p>
                )}
                {project.liveUrl && (
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link"
                  >
                    <Icon name="external-link" size={16} />
                    Live
                  </a>
                )}
              </div>
            </article>
          ))}

          {showGithubTile && (
            <a
              href={SOCIALS.github}
              target="_blank"
              rel="noopener noreferrer"
              class:list={["ghost-tile", rest.length === 0 && "ghost-tile-wide"]}
              data-reveal
            >
              <Icon name="github" size={20} />
              <span>More on GitHub</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  /* ── Featured project ───────────────────────────────────────────────── */
  /* Diagram gets the larger share: its labels are drawn in SVG coordinate
     space, so a narrow column doesn't reflow the type — it shrinks it. */
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-10);
    align-items: center;
    padding: var(--space-10);
  }

  .featured-head,
  .card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .featured h3 {
    font-size: var(--text-3xl);
  }

  .card h3 {
    font-size: var(--text-2xl);
  }

  .status {
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
    white-space: nowrap;
  }

  /* Amber rather than the accent blue: "in progress" is a status, not a
     feature, and shouldn't compete with the links for attention. */
  .status-wip {
    color: #7c5209;
    background: rgba(217, 152, 16, 0.14);
  }

  .status-done {
    color: #166534;
    background: rgba(22, 163, 74, 0.14);
  }

  :global([data-theme="dark"]) .status-wip {
    color: #e0ad4a;
  }

  :global([data-theme="dark"]) .status-done {
    color: #5dc27f;
  }

  .featured-description {
    font-size: var(--text-xl);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .featured-highlights {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
  }

  .featured-highlights li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-secondary);
  }

  /* Icon is a child component with its own scope hash — needs :global(). */
  :global(.highlight-tick) {
    flex-shrink: 0;
    margin-top: 0.2em;
    color: var(--color-accent);
  }

  .featured-diagram {
    min-width: 0;
  }

  /* ── Secondary project grid ─────────────────────────────────────────── */
  .grid {
    display: grid;
    /* Explicit columns rather than auto-fit+minmax: auto-fit forced a 20rem
       minimum track, which overflowed the container on <=375px phones. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .card {
    padding: var(--space-8);
  }

  .card-description {
    margin-bottom: var(--space-5);
  }

  .pipeline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .pipeline-node {
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
    background: var(--color-accent-glow);
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
  }

  .pipeline-arrow {
    color: var(--color-secondary);
    font-size: var(--text-xs);
  }

  /* ── Shared card furniture ──────────────────────────────────────────── */
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
  }

  .stack li {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .stack li:not(:last-child)::after {
    content: "·";
    margin-left: var(--space-2);
    color: var(--color-border);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    text-decoration: none;
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-foreground);
    transition: color 0.2s var(--ease);
  }

  .link:hover {
    color: var(--color-accent);
  }

  .pending {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-md);
    font-style: italic;
  }

  .ghost-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-height: 11rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-secondary);
    font-weight: 600;
    font-size: var(--text-base);
    transition:
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .ghost-tile:hover {
    border-style: solid;
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* With no second project yet, a half-width empty box just looks like a
     missing card. Full-width and short reads as a deliberate footer link. */
  .ghost-tile-wide {
    grid-column: 1 / -1;
    flex-direction: row;
    min-height: 5.5rem;
  }

  @media (max-width: 900px) {
    .featured {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
      padding: var(--space-8);
    }
  }
</style>
