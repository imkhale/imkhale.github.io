---
import Icon from "./Icon.astro";
import { NAME, SOCIALS } from "../../site.config.mjs";

const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="container footer-inner">
    <div class="footer-contact">
      <h2>Let's talk</h2>
      <p class="text-muted">
        Open to Analytics Engineer, BI, and Data roles — reach out directly.
      </p>
      <a href={`mailto:${SOCIALS.email}`} class="footer-email">
        {SOCIALS.email}
      </a>
    </div>

    <div class="footer-links">
      <a
        href={SOCIALS.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link"
      >
        <Icon name="linkedin" size={18} />
        LinkedIn
      </a>
      <a
        href={SOCIALS.github}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link"
      >
        <Icon name="github" size={18} />
        GitHub
      </a>
      <a href={`mailto:${SOCIALS.email}`} class="footer-link">
        <Icon name="mail" size={18} />
        Email
      </a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="text-muted">&copy; {year} {NAME}. All rights reserved.</p>
    <p class="text-muted">Built with Astro.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-24) var(--space-8);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
    padding-bottom: var(--space-16);
  }

  .footer-contact h2 {
    margin-bottom: var(--space-3);
  }

  .footer-contact p {
    max-width: 32ch;
    margin-bottom: var(--space-4);
  }

  .footer-email {
    display: inline-block;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s var(--ease);
  }

  .footer-email:hover {
    text-decoration-color: var(--color-accent);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    text-decoration: none;
    color: var(--color-secondary);
    transition: color 0.2s var(--ease);
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
  }
</style>
