---
import Icon from "./Icon.astro";
import {
  NAME,
  ROLE_HEADLINE,
  ROLE_TAGS,
  SUMMARY,
  IMPACT_STATS,
} from "../../site.config.mjs";
---

<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-inner">
    <p class="hero-eyebrow" data-reveal>{NAME}</p>
    <h1 data-reveal>{ROLE_HEADLINE}</h1>
    <p class="hero-tags text-muted" data-reveal>{ROLE_TAGS.join(" · ")}</p>
    <p class="hero-summary" data-reveal>{SUMMARY}</p>

    <div class="hero-stats" data-reveal>
      {
        IMPACT_STATS.map((stat) => (
          <div class="stat-tile">
            <svg class="stat-icon" viewBox="0 0 24 16" aria-hidden="true">
              <rect class="stat-bar-1" x="0" y="9" width="5" height="7" rx="1.5" />
              <rect class="stat-bar-2" x="9.5" y="5" width="5" height="11" rx="1.5" />
              <rect class="stat-bar-3" x="19" y="0" width="5" height="16" rx="1.5" />
            </svg>
            <span class="stat-value text-mono">{stat.value}</span>
            <span class="text-muted stat-label">{stat.label}</span>
          </div>
        ))
      }
    </div>

    <div class="hero-actions" data-reveal>
      <a href="/cv" class="btn btn-primary">
        View CV
        <Icon name="download" size={16} />
      </a>
      <a href="#contact" class="btn btn-secondary"> Get in touch </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-32) var(--space-24);
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-16);
    }
  }

  .hero-glow {
    position: absolute;
    top: -18rem;
    left: 50%;
    width: 60rem;
    height: 40rem;
    transform: translateX(-50%);
    background: radial-gradient(
      closest-side,
      var(--color-accent-glow),
      transparent 70%
    );
    filter: blur(10px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 52rem;
  }

  .hero-eyebrow {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .hero h1 {
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-6);
    transition-delay: 0.05s;
  }

  .hero-tags {
    font-size: 1.125rem;
    margin-bottom: var(--space-6);
    transition-delay: 0.1s;
  }

  .hero-summary {
    max-width: 42rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-secondary);
    margin-bottom: var(--space-8);
    transition-delay: 0.15s;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
    max-width: 34rem;
    padding-top: var(--space-6);
    margin-bottom: var(--space-8);
    border-top: 1px solid var(--color-border);
    transition-delay: 0.2s;
  }

  .stat-tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .stat-icon {
    width: 1.5rem;
    height: 1rem;
    display: block;
  }

  .stat-icon rect {
    fill: var(--color-accent);
  }

  .stat-icon .stat-bar-1 {
    opacity: 0.35;
  }

  .stat-icon .stat-bar-2 {
    opacity: 0.65;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .stat-label {
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    transition-delay: 0.25s;
  }

  @media (max-width: 480px) {
    .hero-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-3);
      max-width: none;
    }

    .stat-value {
      font-size: 1.25rem;
    }
  }
</style>
