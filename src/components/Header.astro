---
import ThemeToggle from "./ThemeToggle.astro";
import Icon from "./Icon.astro";
import { NAME } from "../../site.config.mjs";

// "Blog" is intentionally left out of nav until real posts exist — the
// content collection currently only has the scaffold sample post, and
// linking to that from primary nav does more harm than not having a
// blog link at all. Add it back once there's at least one real post.
const NAV_LINKS = [
  { href: "/#about", label: "About" },
  { href: "/#skills", label: "Skills" },
  { href: "/#experience", label: "Experience" },
  { href: "/#projects", label: "Projects" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">{NAME}</a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        class="menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" class="icon-open" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="nav-mobile" aria-label="Primary mobile">
    <ul>
      {
        NAV_LINKS.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-background) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.25rem;
  }

  .logo {
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .nav-desktop ul {
    display: flex;
    gap: var(--space-8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-desktop a {
    text-decoration: none;
    font-size: 0.9375rem;
    color: var(--color-secondary);
    transition: color 0.2s var(--ease);
  }

  .nav-desktop a:hover {
    color: var(--color-foreground);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
  }

  /* Icon renders as a child component with its own scope hash, so these
     must be :global() to reach the svg it outputs. */
  :global(.icon-close) {
    display: none;
  }

  .nav-mobile {
    display: none;
    border-top: 1px solid var(--color-border);
    padding: var(--space-4) var(--space-6);
  }

  .nav-mobile ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-mobile a {
    display: block;
    padding: var(--space-3) var(--space-2);
    min-height: 44px;
    text-decoration: none;
    color: var(--color-foreground);
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .nav-desktop {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    :global(.site-header.is-open .icon-open) {
      display: none;
    }

    :global(.site-header.is-open .icon-close) {
      display: block;
    }

    .site-header.is-open .nav-mobile {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector(".site-header");
  const toggle = document.getElementById("menu-toggle");

  toggle?.addEventListener("click", () => {
    const isOpen = header?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
    toggle.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
  });

  // Close the mobile menu after a nav link is tapped.
  document.querySelectorAll("#mobile-nav a").forEach((link) => {
    link.addEventListener("click", () => {
      header?.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
