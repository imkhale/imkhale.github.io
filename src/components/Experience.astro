---
import { EXPERIENCE } from "../data/experience";
---

<section class="section" id="experience">
  <div class="container">
    <h2 data-reveal>Experience</h2>
    <ol class="timeline">
      {
        EXPERIENCE.map((item) => (
          <li class="timeline-item" data-reveal>
            <div class="timeline-period text-muted text-mono">
              {item.period}
            </div>
            <div class="timeline-content">
              <h3>{item.company}</h3>
              {item.companyContext && (
                <p class="text-muted timeline-company-context">
                  {item.companyContext}
                </p>
              )}
              <div class="role-track">
                {item.roles.map((role) => (
                  <div class="role-row">
                    <span class="role-title">{role.title}</span>
                    {item.roles.length > 1 && (
                      <span class="text-muted role-period text-mono">
                        {role.period}
                      </span>
                    )}
                  </div>
                ))}
              </div>
              <p class="text-muted timeline-summary">{item.summary}</p>
              <ul class="timeline-highlights">
                {item.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  h2 {
    margin-bottom: var(--space-12);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--color-border);
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-8);
    padding-block: var(--space-8);
    padding-left: var(--space-8);
  }

  .timeline-item::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 2.6rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .timeline-item:first-child {
    padding-top: 0;
  }

  .timeline-period {
    font-size: 0.875rem;
    padding-top: 0.3rem;
  }

  .timeline-content h3 {
    margin-bottom: var(--space-3);
    font-size: 1.125rem;
  }

  .timeline-company-context {
    font-size: 0.8125rem;
    margin-bottom: var(--space-4);
    max-width: 60ch;
  }

  .role-track {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .role-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: 60ch;
  }

  .role-title {
    font-weight: 600;
  }

  .role-period {
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .timeline-summary {
    margin-bottom: var(--space-4);
    max-width: 60ch;
  }

  .timeline-highlights {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-4);
    max-width: 60ch;
  }

  .timeline-highlights li {
    color: var(--color-secondary);
  }

  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
      padding-left: var(--space-6);
    }
  }
</style>
