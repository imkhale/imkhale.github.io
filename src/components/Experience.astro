---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { EXPERIENCE } from "../data/experience";
---

<section class="section" id="experience">
  <div class="container">
    <SectionHeading
      eyebrow="Track record"
      title="Experience"
      note="7+ years across insurance, industrial manufacturing, and real estate — the most recent 5 building the reporting layer executives run their decisions on."
    />

    <ol class="timeline">
      {
        EXPERIENCE.map((item) => {
          const isCurrent = item.period.includes("Present");
          return (
            <li class="entry" data-reveal>
              <div class="rail" aria-hidden="true">
                <span class:list={["node", isCurrent && "node-current"]} />
              </div>

              <div class="entry-panel surface">
                <div class="entry-head">
                  <div class="entry-identity">
                    <h3>{item.company}</h3>
                    {item.companyContext && (
                      <p class="text-muted company-context">
                        {item.companyContext}
                      </p>
                    )}
                  </div>
                  <span
                    class:list={[
                      "period text-mono",
                      isCurrent ? "period-current" : "text-muted",
                    ]}
                  >
                    {item.period}
                  </span>
                </div>

                <div class="role-track">
                  {item.roles.map((role) => (
                    <div class="role-block">
                      <div class="role-row">
                        <span class="role-title">{role.title}</span>
                        {item.roles.length > 1 && (
                          <span class="text-muted role-period text-mono">
                            {role.period}
                          </span>
                        )}
                      </div>
                      {role.reportsTo && (
                        <span class="text-muted role-reports-to">
                          {role.reportsTo}
                        </span>
                      )}
                    </div>
                  ))}
                </div>

                <p class="text-muted summary">{item.summary}</p>

                <ul class="highlights">
                  {item.highlights.map((highlight) => (
                    <li>
                      <Icon name="arrow-right" size={14} class="hl-marker" />
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>

                {item.techTags && (
                  <ul class="tech">
                    {item.techTags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entry {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: var(--space-6);
  }

  /* The rail is drawn per-entry rather than as one border on the <ol> so it
     can stop cleanly at the last node instead of trailing into whitespace. */
  .rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .rail::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: calc(var(--space-6) * -1);
    width: 1px;
    background: var(--color-border);
  }

  .entry:last-child .rail::before {
    bottom: auto;
    height: 2.75rem;
  }

  .node {
    position: relative;
    z-index: 1;
    margin-top: 2.25rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-border);
    outline: 4px solid var(--color-background);
  }

  .node-current {
    background: var(--color-accent);
    box-shadow: 0 0 0 5px var(--color-accent-glow);
  }

  .entry-panel {
    padding: var(--space-8);
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .entry-identity {
    min-width: 0;
  }

  .entry-panel h3 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .company-context {
    font-size: var(--text-sm);
    line-height: 1.5;
    max-width: 62ch;
  }

  .period {
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
  }

  .period-current {
    color: var(--color-accent);
  }

  .role-track {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .role-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: 64ch;
  }

  .role-title {
    font-weight: 600;
    font-size: var(--text-lg);
  }

  .role-period {
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .role-reports-to {
    display: block;
    font-size: var(--text-sm);
    font-style: italic;
  }

  .summary {
    margin-bottom: var(--space-5);
    max-width: 64ch;
    line-height: 1.65;
  }

  .highlights {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 64ch;
  }

  .highlights li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: var(--color-secondary);
    line-height: 1.6;
  }

  /* Icon is a child component with its own scope hash — needs :global(). */
  :global(.hl-marker) {
    flex-shrink: 0;
    margin-top: 0.35em;
    color: var(--color-accent);
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-6) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .tech li {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-secondary);
    background: var(--color-muted);
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
  }

  @media (max-width: 640px) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    /* The rail costs more than it earns on a narrow screen — the panels
       already read as a sequence. */
    .rail {
      display: none;
    }

    .entry-panel {
      padding: var(--space-6);
    }

    .entry-head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
